section><section><span><br/></span></section></section></section><section><section><section><section><section><p><span>图/李意顺</span></p><p><span><span>文/李意顺</span></span></p><p><span>编辑/新闻中心 李思蓉</span></p><p><span>审核/高立浩、李安然</span></p></section></section><section></section><section></section><section></section></section></section></section></section><section><span><br/></span></section><p></p></div>","textSha256":"2829403f714da428c240387b68a1716d02b8ce347545bcd8adf636c1e7a21f90","textLength":2796,"sourceSha256":"a0e3db64eeeeef15d68433dfe605be5b8f23857b61cf98e79b2e1254eac18894","selector":"#js_content","attachments":[],"pdfs":[],"unavailableMedia":[],"id":"syp-08e84a7e80cda2b7c229","title":"2026年北京信息科技大学信息与通信工程学院2027年接收推荐免试研究生接收工作实施细则","capturedAt":"2026-11-15T16:55:53.013084+00:00"}
