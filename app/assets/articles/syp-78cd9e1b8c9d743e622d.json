n></section><section><p><span><br/></span></p></section><section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_png/F0EDib1icpDme0gsFUgtajMIdo2qxPllHibC5CfFR1Y0ysos5TcVvrHiaOhuMjKAquiaMkFsanXNbc7dsLUiaeAPFec9OmNVgbicPWRXYlM8qnO3bw/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_gif/F0EDib1icpDmfWzqNx2IGZ56ib5QchMViaflLgQ2rCCJS2PlvhiaDpy2xezwZGZwzq3WJtQVicRUsiaJMq6YvEORFVCFINhgMj265FgBmOpWH7mBCo/640?wx_fmt=gif&amp;from=appmsg\"/></section></section></section><p><span><br/></span></p><p><span><br/></span></p></section></section><section><span><br/></span></section><p></p></div>","textSha256":"8b9808a0589f4afaf1ae6bf76dbd808d7e01058c3c37e26893a703abd9ca450e","textLength":2302,"sourceSha256":"a090ab8aac73cbe74b0577fb712b2374847f3e8bac4798c9a172d4853078ae34","selector":"#js_content","attachments":[],"pdfs":[],"unavailableMedia":[],"id":"syp-78cd9e1b8c9d743e622d","title":"2026年安徽医科大学基础医学院2026年全国优秀大学生暑期夏令营招生通知","capturedAt":"2026-11-15T16:51:15.845729+00:00"}
