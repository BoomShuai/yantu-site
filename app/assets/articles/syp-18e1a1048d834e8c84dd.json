><tr><td><p><span>14</span></p></td><td><p><span>计算学部</span></p></td><td><p><span>谭知行</span></p></td><td><p><span>zxtan@zgclab.edu.cn</span></p></td></tr><tr><td><p><span>15</span></p></td><td><p><span>计算学部</span></p></td><td><p><span>王嘉凯</span></p></td><td><p><span>wangjk@zgclab.edu.cn</span></p></td></tr><tr><td><p><span>16</span></p></td><td><p><span>计算学部</span></p></td><td><p><span>王帅</span></p></td><td><p><span>wangshuai@zgclab.edu.cn</span></p></td></tr><tr><td><p><span>17</span></p></td><td><p><span>计算学部</span></p></td><td><p><span>王松涛</span></p></td><td><p><span>wangst@zgclab.edu.cn</span></p></td></tr><tr><td><p><span>18</span></p></td><td><p><span>计算学部</span></p></td><td><p><span>王雅哲</span></p></td><td><p><span>wangyz@zgclab.edu.cn</span></p></td></tr><tr><td><p><span>19</span></p></td><td><p><span>计算学部</span></p></td><td><p><span>吴广君</span></p></td><td><p><span>wugj@zgclab.edu.cn</span></p></td></tr><tr><td><p><span>20</span></p></td><td><p><span>计算学部</span></p></td><td><p><span>徐小琳</span></p></td><td><p><span>xuxl@zgclab.edu.cn</span></p></td></tr><tr><td><p><span>21</span></p></td><td><p><span>计算学部</span></p></td><td><p><span>殷其雷</span></p></td><td><p><span>yinql@zgclab.edu.cn</span></p></td></tr><tr><td><p><span>22</span></p></td><td><p><span>计算学部</span></p></td><td><p><span>余翔湛</span></p></td><td><p><span><span>     </span>yxz@hit.edu.cn</span></p></td></tr><tr><td><p><span>23</span></p></td><td><p><span>计算学部</span></p></td><td><p><span>岳银亮</span></p></td><td><p><span>yueyl@zgclab.edu.cn</span></p></td></tr><tr><td><p><span>24</span></p></td><td><p><span>计算学部</span></p></td><td><p><span>云晓春</span></p></td><td><p><span><span>     </span>yxz@hit.edu.cn</span></p></td></tr><tr><td><p><span>25</span></p></td><td><p><span>计算学部</span></p></td><td><p><span>尹涛</span></p></td><td><p><span>yintao@zgclab.edu.cn</span></p></td></tr><tr><td><p><span>26</span></p></td><td><p><span>计算学部</span></p></td><td><p><span>闫兆腾</span></p></td><td><p><span>yanzt@zgclab.edu.cn</span></p></td></tr><tr><td><p><span>27</span></p></td><td><p><span>计算学部</span></p></td><td><p><span>赵汇海</span></p></td><td><p><span>zhaohh@zgclab.edu.cn</span></p></td></tr><tr><td><p><span>28</span></p></td><td><p><span>计算学部</span></p></td><td><p><span>赵军</span></p></td><td><p><span>zhaoj@zgclab.edu.cn</span></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><span>29</span></td><td colspan=\"1\" rowspan=\"1\"><span>计算学部</span></td><td colspan=\"1\" rowspan=\"1\"><span><span>何慧</span></span></td><td colspan=\"1\" rowspan=\"1\"><span>hehui@hit.edu.cn</span></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><span><span>30</span></span></td><td colspan=\"1\" rowspan=\"1\"><span>计算学部</span></td><td colspan=\"1\" rowspan=\"1\"><span>丁效</span></td><td colspan=\"1\" rowspan=\"1\"><span>xding@ir.hit.edu.cn </span></td></tr></tbody></table><p>注：导师名单根据需求调整</p></div></div>","textSha256":"92966912b3576bc791c4459a79973c3ebc933ce57d9eb1a54f36e8290f9a1e51","textLength":2328,"sourceSha256":"f9026335a354af29229df9ab060a7fed528dcd86ce0fc90e37592baebb8c9668","selector":".wp_articlecontent","attachments":[],"pdfs":[],"unavailableMedia":[],"id":"syp-18e1a1048d834e8c84dd","title":"2026年哈尔滨工业大学与国家实验室联培——2027年中关村实验室科研计划博士招生简介","capturedAt":"2026-11-15T16:52:50.899076+00:00"}
