ion><section><section><section><section><section><p><span><br/></span></p></section></section></section><section><span><strong><span>微信小程序</span></strong></span></section></section><section><section><section><section><p><span><br/></span></p></section></section></section><section><span><strong><span>视频号</span></strong></span></section></section></section></section></section></section></section><p><span><br/></span></p></section><section><p><span><span><span>部分图片来源网络  版权属原作者</span></span></span></p><p><span><span><span>本公众号致力于科普宣传，无任何商业用途，</span></span></span></p><p><span><span><span>若有文字、图片、视频涉及侵权或违规，请及时告知删除。</span></span></span></p></section></section><section><p><span><br/></span></p></section></section><section><span><br/></span></section><p></p></div>","textSha256":"2c1623da260235a076738d11bcf36b9ce49c85ffcc80d8c4ee6462b558911f2d","textLength":2446,"sourceSha256":"f5013f7e6b550f549a4d1c0e69d3efd6f089ce649cdb3f5b7825818f0e01286d","selector":"#js_content","attachments":[],"pdfs":[],"unavailableMedia":[],"id":"syp-87a8e4d00977c12153bf","title":"2026年汕头大学医学院第一附属医院（第一临床学院）盛夏逐梦医路，相约侨乡潮汕！汕头大学医学院第一临床学院2026优秀大学生暑期夏令营等你报名","capturedAt":"2026-11-15T16:51:18.937686+00:00"}
