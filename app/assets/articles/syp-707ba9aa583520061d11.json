bMH8mwyNruHYZ8Q/640?wx_fmt=png\"/></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_png/icJYcMv2h7Ka169eFX9n14mhykGIicnZdU2mEMicoye6eibwXYDSWggnlegICgCGpibYZNyLw0FO21AZZfTUyvaGyEA/640?wx_fmt=png\"/></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_png/icJYcMv2h7Ka169eFX9n14mhykGIicnZdUUmgrU4MAlhBUnZpe9YTrIictARpeRMKPfzPBKrjklcIaKn3Myf5Hibicg/640?wx_fmt=png\"/></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_png/icJYcMv2h7Ka169eFX9n14mhykGIicnZdUficOKFbNiapUFzZZxhjx08OxN4mV4dybN4Dh7lrN98LhV5A69UkNqYxQ/640?wx_fmt=png\"/></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_png/icJYcMv2h7Ka169eFX9n14mhykGIicnZdUVVS5k9Eib0YejFNlJ5z8Wh7FyV4ksbiadYLAXwk0wiaD62KwP9m1SNNrw/640?wx_fmt=png\"/></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_png/icJYcMv2h7Ka169eFX9n14mhykGIicnZdUsVz5enlSCmHaLOcFzd29dabrUMy0NyJmaSRKjGmicQNToDSMCiccdA1w/640?wx_fmt=png\"/></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_png/icJYcMv2h7Ka169eFX9n14mhykGIicnZdUuBK9fOwyyjZzh6A5qnougiclUgl609ianpkPhYbmjPFcNlWEaNXWH7hg/640?wx_fmt=png\"/></section></section></section><section><section><section></section></section></section><section></section><section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_jpg/KNDyicosGP0QcnT6K3btjxtiagRRXmvg0cuO9t1qk5gBMnj2xia7oUtgrYTOygKPW7CQ5lE0XX6YDC3Lr3QBoo3NgfgK2iabEF4uEu6lU0TtGnk/640?wx_fmt=jpeg\"/></section></section></section><section></section></section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_png/KNDyicosGP0Qh9eAKic6ianeLkkuKz2q5sEzibb4xpYq02uib6OsM7wtksqWcuNoHtViaaqBoANM26c3F7puOU4Q9pKLxq4bibDTzAfyE8VEQ5mhsA/640?wx_fmt=png\"/></section></section></section><section><section><section><section><section><p><span><br/></span></p></section></section></section></section></section></section><section><section><section><p><span>厦门大学因海而生，伴海而长，厦门大学海洋学科伴随着这所“南方之强”走过了百载峥嵘岁月，同时也见证了中国海洋科学发展的光辉历程，被誉为我国海洋科教的“蓝色摇篮”。早在上个世纪20年代建校之初，厦门大学就在国内率先开展海洋生物科学的研究，文昌鱼研究成果见诸《Science》期刊；1946年成立中国第一个海洋学系；1996年组建海洋与环境学院；2011年成立海洋与地球学院，2017年海洋学科入选国家“双一流”建设学科名单。经过几代海洋人的努力，如今的海洋学科优势明显，是我国海洋科学研究与人才培养的“重镇”，在2025年软科世界一流学科中排名第9，在国际上享有嘉誉。</span></p><p><span>学院拥有海洋科学一级学科国家重点学科，海洋科学一级学科博士学位授权点和博士后流动站；建成涵盖海洋生物学、海洋生物技术、海洋化学、物理海洋学、海洋物理、海洋地质、气候变化应对等专业在内的门类齐全、层次完整的学科体系。学院拥有海洋生物地球化学全国重点实验室（MEL）、海水养殖生物育种全国重点实验室、海洋生物制备技术国家地方联合工程实验室、鹭江创新实验室等高水平科研平台；建成由“嘉庚”号海洋科学综合考察船、福建台湾海峡海洋生态系统国家野外科学观测研究站、“海丝”系列卫星构成的“海-陆-空”一体化立体观测体系。</span></p><p><span>为促进我国高校优秀大学生之间的交流，增强青年学生对海洋学科学习和研究的兴趣，让广大青年学子近距离了解厦门大学海洋学科，厦门大学海洋与地球学院将于2026年7月举办2026年“厦门大学全国优秀大学生海洋科学夏令营”活动。</span></p><p><span>现将本次夏令营活动的有关事项通知如下：</span></p></section><section><p><span><br/></span></p></section><section><p><span><br/></span></p></section></section></section><p><span><br/></span></p><section><section><section><section><section><section><section><section><p><strong><span>part 1</span></strong></p></section></section></section><section><section><section><p><strong><span>申请资格</span></strong></p></section></section></section></section></section></section></section></section><section><section></section></section><section><section><section><p><span>（1）具有坚定的社会主义理想信念，拥护中国共产党的领导，遵纪守法，品德良好，诚实守信，学风端正，身心健康，不存在任何有违学术道德、专业伦理等行为；</span></p><p><span>（2）全国高校海洋科学、海洋技术、海洋资源与环境、物理学、地球物理学、数学、生物学、化学、地质学、地球化学、地球信息科学与技术、生物科学、生物技术、生态学、船舶与海洋工程、环境科学与工程等相关相近专业的本科三年级在校生（2027年9月前取得学历学位证书）；</span></p><p><span>（3）对海洋科学及相关专业（海洋生物学、海洋生物技术、海洋化学、物理海洋学、海洋物理、海洋地质、海洋资源与环境）有浓厚兴趣，并有较强或潜在的科研能力；</span></p><p><span>（4）成绩要求：申请者须学习成绩优秀，专业成绩和综合成绩均名列本专业或年级前茅；</span></p><p><span>（5）英语水平良好，全国大学英语四级考试成绩达到425分及以上，或TOEFL、GMAT、GRE或IELTS考试成绩达到总分的60%及以上。</span></p></section></section></section><p><span><br/></span></p><section></section><p><span><br/></span></p><p><span><br/></span></p><section><section><section><section><section><section><section><section><p><strong><span>part 2</span></strong></p></section></section></section><section><section><section><p><b><span>申请流程</span></b></p></section></section></section></section></section></section></section></section><section><section></section></section><section><section><section><p><strong><span>1．报名时间：</span></strong></p><p><span><strong><span>6月15日0:00-6月30日17:30</span></strong></span><strong><span>。</span></strong></p></section><section><section><p><strong><span>2.申请材料：</span></strong></p><p><span>（1）申请表1份（报名系统自动生成，网址：https://dxsxly.xmu.edu.cn）；</span></p><p><span>（2）个人陈述；</span></p><p><span>（3）本科成绩单及成绩排名（大一、二、三年级阶段成绩，须加盖所在学校教务部门或所在学院教务部门公章）；</span></p><p><span>（4）英语四六级水平证书复印件或相关成绩证明（须加盖所在学院公章）；</span></p><p><span>（5）两位副教授及以上专家的推荐信；</span></p><p><span>（6）其他材料（获奖证书、科研成果、论文等复印件）。</span></p></section></section><section><section><p><strong><span>3.申请方式：</span></strong></p><p><span>登录报名系统报名（网址：https://dxsxly.xmu.edu.cn）。提交报名后，在“已报名项目”中下载打印申请表，相关部门签字盖章之后，连同个人陈述、成绩单、成绩排名、推荐信、四六级证书等申请材料扫描合并成一个PDF</span><strong><span>（文件名格式：申请专业-姓名-学校）</span></strong><span>，并以附件方式上传到报名系统，在开营报到时提交所有纸质申请材料。</span></p></section></section><section><section><p><strong><span>4.入营选拔：</span></strong></p><p><span>我院夏令营活动工作组将根据申请者的专业、申报系（所/中心）和专业、成绩及排名、科研成果、所获奖励、外语水平和综合素质等因素，同时兼顾办营规模、生源质量与生源区域以及院校分布的合理性等因素，全面考量、综合评估，择优选拔出参营营员。入选者名单以电子邮件形式直接通知申请者本人，未入选者不再另行通知。</span></p></section></section></section></section><p><span><br/></span></p><p><span><br/></span></p><p><span><br/></span></p><section><section><section><section><section><section><section><section><p><strong><span>part 3</span></strong></p></section></section></section><section><section><section><p><strong><span>活动安排</span></strong></p></section></section></section></section></section></section></section></section><section><section><section><section><section></section></section></section></section></section><section><section><section><p><span>本次夏令营将于</span><strong><span><span>7月12日-7月13日</span></span></strong><span>开展，具体活动安排将另行通知，敬请留意入营邮件。</span></p></section></section></section><p><span><br/></span></p><p><span><br/></span></p><p><span><br/></span></p><section><section><section><section><section><section><section><section><p><strong><span>part 4</span></strong></p></section></section></section><section><section><section><p><b><span>其他</span></b></p></section></section></section></section></section></section></section></section><section><section><section><section><section></section></section></section></section></section><section><section><section><p><span>我院将为营员提供活动期间（线下举办）在厦的食宿费用。</span></p></section></section></section><p><span><br/></span></p><p><span><br/></span></p><p><span><br/></span></p><section><section><section><section><section><section><section><section><p><strong><span>part 5</span></strong></p></section></section></section><section><section><section><p><b><span>联系方式</span></b></p></section></section></section></section></section></section></section></section><section><section><section><section><section></section></section></section></section></section><section><section><section><p><span>联系人：邹老师</span></p><p><span>联系电话：0592-2880105</span></p><p><span>E-mail：coezs@xmu.edu.cn</span></p></section></section></section><section><section><section><section></section><section><section><section><section><section><p><span><br/></span></p></section></section></section></section></section></section><section><section><section><section><section><section><p><strong><span>往期精彩</span></strong></p></section></section></section></section></section></section><section><section><section><p><span><br/></span></p></section></section></sectio