fOpjvAZZ1HVs4XWvtVTCRpPzFw/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section></section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_png/iaw6kJtUxEV70nKz9Cb6icsGpGM6JibYIh8IDdebIBibkl6GjbvPp88jXDnU3HmzhS1dgrcpypdoOuBclvkiasfSlQianmdB18evtuXiaKXJKPQ1c0/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section></section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_png/iaw6kJtUxEV6vz9icvCghocAMLNAybpmxHstBrRqicVNXwIGkVn5s1KFEDHsNeeU7Nib8ibqWI2767dhtCgMElMwd530YLX7Xj10QSF6cyrm8Kpw/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section></section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/iaw6kJtUxEV5KIBX5oicVbQwThRG2GOiahHps10pawQV53lXQwxQhQHAJIAJPzwqW3efW3EmuyEcQm0DxCrCuCfibicOZd32MSricdKPZGpGiatpCQ/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section></section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_png/iaw6kJtUxEV4FBaxOWrXK3xdN3rpfHxccYyIceZxibj6MeZhP8ZuYgV0ic21MTW4I0pyyOfvYrJqg4gaO6Efh0Fic8hsXDHpqVvLk4XW3icSHGWY/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section></section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_png/iaw6kJtUxEV5xFialGz2HiaDVG2dCX5Cjg2OUXcwK7u9cqRvQJMMPyAESeR3zWQ94My5SPJhdrAJILkgfXTEyYXReCtLVskzHW1xwvV2RySNMo/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section></section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_png/iaw6kJtUxEV5ia5auDbIhJNtTLkzWZb2qFr8b9lb1cl4Yov0Z66ric19RMWEE2E1d8kNNG09nOEt3sJ6UdFkSec2k1uYXBfT5FrYYxI92ScO8M/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section></section><section><section><section><p><strong><span><span>四川大学华西公共卫生学院/华西第四医院</span></span></strong></p></section></section></section><section><section><section><p><strong><span><span>2027年接收推荐免试攻读研究生</span></span></strong></p><p><strong><span><span>及直接攻读博士研究生</span></span></strong></p><p><strong><span><span>预报名通知</span></span></strong></p></section></section></section><section></section></section><p><span><br/></span></p><section><section><section><p><span>四川大学华西公共卫生学院/华西第四医院是我国最著名的公共卫生学院之一和国家卫健委44家委属委管医院中唯一的一所三级甲等职业病专科医院。学院/医院设有“公共卫生与预防医学”和“公共卫生”两个一级学科授位点。2022年入选首批国家高水平公共卫生学院建设单位，2024年国内首批获得公共卫生专业学位博士授权点。</span></p><p><span>我院现有教职工约1200余人，我院现有博导40人、硕导88人，其中国家级高层次人才计划入选者11人、12人次，四川省高层次人才计划入选者18人，四川大学“双百人才工程”入选者11人，四川省学术和技术带头人及后备人选20人。在2025年、2026年“软科中国大学专业排名”中，我院卫生检验与检疫专业、食品卫生与营养学专业为A+级专业且排名全国第一，预防医学专业为A级专业。营养与食品卫生学为国家重点学科。</span></p><p><span>我院科研实验平台面积超4000平方米，设备价值超1亿元，有主动健康与营养食品安全四川省重点实验室、职业卫生与职业医学省重点实验室和分子毒理四川省重点实验室；教学实验平台有省级实验教学示范中心和公共卫生与预防医学实验中心。</span></p></section><section><section><section><section><section><section><p><span><br/></span></p></section></section></section></section></section><section><section><section></section></section></section></section></section></section><p><span><br/></span></p><section><section><section><section><section></section></section></section><section><section><section><p><strong><span>一、申请条件</span></strong></p></section></section></section><section><section></section></section></section></section><section><section><section><p><span><span>1.</span>拥护中国共产党的领导，愿为社会主义现代化建设服务，身体健康，品德良好，遵纪守法。</span></p><p><span><span>2.</span>应届本科毕业生且已获得本人所在学校的推荐免试资格。</span></p><p><span><span>3.</span>可于2027年顺利毕业并获得学士学位。</span></p><p><span><span>4.</span>来自高水平学校的学生。</span></p></section></section></section><p><span><br/></span></p><section><section><section><section><section></section></section></section><section><section><section><p><strong><span>二、接收专业</span></strong></p></section></section></section><section><section></section></section></section></section><section><section><section><p><span>四川大学2027年研究生招生专业目录尚未公布，可参照“川大学2026年推免（含直博）研究生考试招生专业目录”，查询网址：https://yz.scu.edu.cn/sszyml/tmsml。各学科实际接收人数可能会根据生源情况做适度调整。报考本院推免及直博的同学，请与意向导师进行邮件或者电话联系，确认报考信息。导师联系方式和介绍见学院官方网站（https://www.wcfh.com.cn/zhb_zjjs_szdw）。</span></p></section><section><p><span><br/></span></p></section><section><section><section><section><section><section><section><p><strong><span>特别提醒：</span></strong></p></section></section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_png/iaw6kJtUxEV7M4MENBwqhs4pVthJKa4ThAtuxPbuMvXickrVk5n72otfRSkdcnY2X2rzaibO9LJ7HYWy5eypUibDRFncLgxsicLrE0lEYQOsfThY/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section></section></section></section></section><section><p><span>华西公共卫生学院自2024年起研究生招生实行大类招生，即招生目录中仅设置“公共卫生与预防医学（学科代码：100400）”及“公共卫生（学科代码：105300）”两个专业，下设流行病与卫生统计学、营养与食品卫生学等不同方向（毕业证及学位证上仅体现专业，不呈现方向）。</span></p><p><span>我院面向本科为全日制临床医学专业学生开设“医防融合临床实践”方向，带教导师均为临床医师，请有意的同学积极报名。</span></p></section></section></section></section></section><p><span><br/></span></p><section><section><section><section><section></section></section></section><section><section><section><p><strong><span>三、申请、复试、录取程序</span></strong></p></section></section></section><section><section></section></section></section></section><section><section><section><p><strong><span>1.</span></strong><span>凡有意报考我院2027年推免（含直博生）研究生的应届本科毕业生，请点击以下链接，完成预推免的报名工作：https://yz.scu.edu.cn/xly/login/，预推免网报截止时间：2026年9月10日23:59。</span></p><p><strong><span>2.</span></strong><span>考生需交验材料（在四川大学预推免系统https://yz.scu.edu.cn/xly的附件中上传以下材料的扫描件）：</span></p></section><section><section><p><span>（1）学生证、第二代身份证复印件；</span></p><p><span>（2）本科成绩单、推免排名证明复印件（需加盖培养部门公章）；</span></p><p><span>（3）其他各种能力证明材料（如大学英语四、六级考试成绩单、获奖证书、本人代表性学术论文、参与项目证明、出版物或原创性工作成果等）复印件。</span></p><p><span>（4）申请直接攻博的学生还需提交《四川大学2027年招收直接攻读博士学位研究生入学申请表》（见附件1）。</span></p></section></section><section><p><span>请将以上材料按顺序扫描合成为1个PDF文件，上传到报名系统。</span></p><p><strong><span>3.</span></strong><span>我院将在2026年9月15日左右在预推免报名系统中完成审核，并在学院官网发布预推免复试通知。凡通过审核的均可参加我院的预推免复试，本次复试采取线下复试形式。</span></p><p><strong><span>4.</span></strong><span>预计2026年9月底（具体以教育部发布正式通知为准），获得推免生资格且符合申请条件者须在国家规定时间内登录“全国推荐免试攻读研究生（免初试、转段）信息公开暨管理服务系统”（网址：https://yz.chsi.com.cn/tm）（以下简称“推免服务系统”）报名。</span></p></section></section></section><p><span><br/></span></p><section><section><section><section><section></section></section></section><section><section><section><p><strong><span>四、奖助学金</span></strong></p></section></section></section><section><section></section></section></section></section><section><section><section><p><span>四川大学全日制研究生奖助体系完备，由国家奖助金和学校奖助金两部分构成。国家奖助金包括国家奖学金和国家助学金，学校奖助金包括学校学业奖学金和学校“三助”岗位津贴。具体情况请详见《四川大学研究生奖助体系实施方案》（详情参见我校研究生院官网）。</span></p></section></section></section><p><span><br/></span></p><section><section><section><section><section></section></section></section><section><section><section><p><strong><span>五、咨询、联系方式</span></strong></p></section></section></section><section><section></section></section></section></section><section><section><section><p><strong><span>四川大学研究生招生信息网：</span></strong><span>https://yz.scu.edu.cn/</span></p><p><strong><span>华西公共卫生学院网址：</span></strong><span>http://wcsph.scu.edu.cn/index.htm</span></p><p><strong><span>华西公共卫生学院研究生部：</span></strong><span>028-85501599  张老师、周老师</span></p></section></section></section><p><span><br/></span></p><section><section><section><section><section></section></section></section><section><section><section><p><strong><span>六、举报受理渠道</span></strong></p></section></section></section><section><section></section></section></section></section><section><section><section><p><span>学院成立“研究生复试工作举报受理小组”，接受考生的实名举报。举报受理小组在接到举报后，展开调查，在5个工作日以内回复举报人。</span></p><p><strong><span>联系电话：</span></strong><span>028-85502682</span></p></section><section><p><strong><span>邮箱：</span></strong><span>gwsyjj@163.com</span></p></section></section></section><p><span><br/></span></p><section><section><section><section><section></section></section></section><section><section><section><p><strong><span>七、其他事项</span></strong></p></section></section></section><section><section></section></section></section></section><section><section><section><p><strong><span>1.</span></strong><span>申请人必须保证所提交申请材料的真实性和准确性。若申请人提交的信息不真实或不准确，不予录取。</span></p><p><strong><span>2.</span></strong><span>政审、体检不合格以及在入学报到时未获得毕业证书及学士学位证书者，学校将取消其录取资格。</span></p><p><strong><span>3.</span></strong><span>申请人目录查询、信息注册、上传照片、缴费、填报志愿、接收复试和待录取等都在“推免服务系统”上进行，已被四川大学接收的推免生，不得再报名参加当年硕士研究生考试招生，否则取消其推免录取资格。</span></p><p><strong><span>4.</span></strong><span>违规违纪者、学术不端者、诚信缺失者不予录取。已经拟录取的，取消录取资格。</span></p><p><strong><span>5.</span></strong><span>申请人应及时关注我院发布、发送的相关招生文件、通知，因申请人个人疏忽等原因造成的一切后果由其本人承担。</span></p></section></section></section><p><span><br/></span></p><section><p><span>附件：1. 四川大学招收直接攻读博士学位研究生入学申请表</span></p><p><span><a href=\"https://mp.weixin.qq.com/s/TI9auSo_SAOQvzCEy7fzzQ\" rel=\"noopener noreferrer\" target=\"_blank\"><span>附件1：四川大学2027年招收直接攻读博士学位研究生入学申请表.doc</span></a></span></p></section><p><span><br/></span></p><section><section><section><p><span>四川大学 </span></p></section></section><section><section><p><span>华西公共卫生学院</span></p></section><section><p><span>华西第四医院</span></p></section></section></section><section><section><p><span>2026年9月4日</span></p></section></section><p><span><br/></span></p></section><section><span><br/></span></section><section><span><span>来源：研究生部</span></span></section></section><section><span><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_jpg/iaw6kJtUxEV4aJic2iasU5EJqKzlGvIoyEFhW5PbbdbicqmBkZsKicdcOC8RrldAS6XSDdds5ibqDd9w9iaVFGJNTYJVVZv01ufx3ibTWj0z2GdeDias/640?wx_fmt=jpeg&amp;from=appmsg\"/></span></section><p></p></div>","textSha256":"672dcdcd8fc7db5b08b601c7a1c16b89f4aca8c2d4f8166d93886cccf3c7a6f8","textLength":2357,"sourceSha256":"ed6061ed49be07578b9fc9050c8ab2e4469bf02fdb9fb3a71c0a9ba0189d17c0","selector":"#js_content","attachments":[],"pdfs":[],"unavailableMedia":[],"id":"syp-24c94c28a6953a81cf05","title":"2026年四川大学华西公共卫生学院/华西第四医院2027年接收推荐免试攻读研究生及直接攻读博士研究生预报名通知","capturedAt":"2026-11-15T16:52:49.971888+00:00"}
