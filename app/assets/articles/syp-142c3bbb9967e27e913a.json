n<td rowspan=\"2\"><p><span><span>马克思主义学院</span></span></p></td>\n<td><p><span><span>电话：</span><span>010－89534224</span></span></p></td>\n</tr>\n<tr>\n<td><p><span><span>邮箱：</span></span><span><a href=\"mailto:guojiwu2010@sina.com\" rel=\"noopener noreferrer\" target=\"_blank\"><span>guojiwu2010＠sina.com</span></a></span></p></td>\n</tr>\n<tr>\n<td rowspan=\"2\"><p><span><span>9</span></span></p></td>\n<td rowspan=\"2\"><p><span><span>系统科学与统计学院</span></span></p></td>\n<td><p><span><span>电话：</span><span>010－89535613</span></span></p></td>\n</tr>\n<tr>\n<td><p><span><span>邮箱：</span></span><span><a href=\"mailto:tsxyky@163.com\" rel=\"noopener noreferrer\" target=\"_blank\"><span>tsxyky＠163.com</span></a></span></p></td>\n</tr>\n<tr>\n<td rowspan=\"2\"><p><span><span>10</span></span></p></td>\n<td rowspan=\"2\"><p><span><span>智能工程与供应链创新学院</span></span></p></td>\n<td><p><span><span>电话：</span><span>13260442769</span></span></p></td>\n</tr>\n<tr>\n<td><p><span><span>邮箱：</span></span><span><a href=\"mailto:zlky@bwu.edu.cn\" rel=\"noopener noreferrer\" target=\"_blank\"><span>zlky＠bwu.edu.cn</span></a></span></p></td>\n</tr>\n</tbody>\n</table>\n</div>\n<p><span> </span></p>\n</div>\n</div></div>","textSha256":"80cb395c26108465724ff0a9158e7bd1c32549e8fbcc1be3e1a377ac640cabf3","textLength":2626,"sourceSha256":"62a6ae73af01f9b5bd49f85636f06e18e352d86805a109089e933cb516539c77","selector":"#vsb_content","attachments":[{"name":"附件1.北京物资学院2027年接收推免生招生专业目录.pdf","url":"https://yjsb.bwu.edu.cn/system/_content/download.jsp?urltype=news.DownloadAttachUrl&owner=1119106339&wbfileid=3216079"},{"name":"附件2：北京物资学院2027年接收推荐免试攻读硕士学位研究生申请表.docx","url":"https://yjsb.bwu.edu.cn/system/_content/download.jsp?urltype=news.DownloadAttachUrl&owner=1119106339&wbfileid=3215064"},{"name":"附件3：诚信考试承诺书.docx","url":"https://yjsb.bwu.edu.cn/system/_content/download.jsp?urltype=news.DownloadAttachUrl&owner=1119106339&wbfileid=3215063"},{"name":"附件4：北京物资学院2027年接收推荐免试攻读硕士学位研究生申请材料汇总表.docx","url":"https://yjsb.bwu.edu.cn/system/_content/download.jsp?urltype=news.DownloadAttachUrl&owner=1119106339&wbfileid=3215067"}],"pdfs":[],"unavailableMedia":[],"id":"syp-142c3bbb9967e27e913a","title":"2026年北京物资学院2027年接收推荐免试攻读硕士研究生工作办法","capturedAt":"2026-11-15T16:56:13.227372+00:00"}
