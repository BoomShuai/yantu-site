licy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsXHia3GMdkRSx1FbFFAmFwxRVuK3XbNujhfVodcN2nHOkdSnAiaBnjB5g/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section></section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsyfKEhicyF6u5Yj3N9bMBaeDCickGKzIvNbl2eWGicIIr8z6S5noVJnNSA/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_gif/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMs7Sna6WvW3ouN3A8dpOymJvq5ibgNicUF2yIexYfPZHFt6O0IcqOgyoQA/640?wx_fmt=gif&amp;from=appmsg\"/></section></section></section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsc0QmdichpVHZtaesdibJuQc1k47TDeohVkZ5u23t6wQ6FkHwTfbfS6Ew/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_gif/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsNt2emDyvndjmwLjFZaibmBKPZdfQsBna7geCRHzWktlOo9yvbGjudaw/640?wx_fmt=gif&amp;from=appmsg\"/></section></section></section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsn4zFb55gr70wibhJkoEyBlFdVMKJ6P1faxyT4ficdnhniaWT6HLcRSkjw/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_gif/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMspcqAhiaWosib8dLcZjAILG2ahDP9TDRFa2D1icAWRyBQqD2a7BXeTulDQ/640?wx_fmt=gif&amp;from=appmsg\"/></section></section></section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsHwZW8gcNafSNefdy2U3OEFbtgmjV8yewVdY24eLp1pyQxE8qB42hpA/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section></section><section><section><section><p><strong><span>夏令营报名通知</span></strong></p></section></section></section><section></section></section><p><span><br/></span></p><section><section><section><p><span>为促进与国内高等院校优秀大学生的交流，中山大学先进制造学院2025年全国优秀大学生夏令营活动拟定于7月7日至7月8日举办。本次夏令营将通过专题讲座、实地参观、师生交流等多种形式，帮助优秀学子了解中山大学先进制造学院的科研、教学和师资情况，激发科研热情，选择未来的科研方向。欢迎有意推荐免试至我院攻读研究生的同学关注和报名。</span></p></section></section></section><p><span><br/></span></p><p><span><br/></span></p><section><section><section><section><section><p><span><b><span>学院简介</span></b></span></p></section></section></section></section></section><section><section><section><section><section><p><span><br/></span></p></section><section><p><span>中山大学先进制造学院创办于2021年2月，是中山大学新工科布局深圳校区的重要组成部分。学院面向国家建设先进制造体系，落实立德树人根本任务，秉持“修身、立命、勤学、索新”理念，服务粤港澳大湾区先进制造技术和产业发展对高层次科技人才的需求，充分发挥深圳在高端装备制造业的创新型集群优势，重点发展“超精密制造”“增材制造”“智能制造”和“未来制造”等方向。增强制造领域自主创新能力和整体实力，培养高水平人才，为国家和区域先进制造业高速发展、建设制造强国战略提供科技和智力支撑。</span></p></section></section></section></section></section><p><span><br/></span></p><p><span><br/></span></p><p><span><br/></span></p><section><section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsFH46Vn0hpeibeDictwwXY8Ju9LI1BOfWPohvGUsS2uxzTWu8V9vk5lmg/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_gif/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsNt2emDyvndjmwLjFZaibmBKPZdfQsBna7geCRHzWktlOo9yvbGjudaw/640?wx_fmt=gif&amp;from=appmsg\"/></section></section><section><section><section><section><p><strong><span>活动详情</span></strong></p></section></section></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_gif/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsAIpRLbk70GPZdnMXFr84F4fF4uta0yrv8e9zAbD7BmbaHdibiarWmGNw/640?wx_fmt=gif&amp;from=appmsg\"/></section></section></section></section></section></section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsDYQh5KWOQrdENDBQg2O33gUiblrkjCwWFgz1VPcOcJYBXGmcn1hNjwQ/640?wx_fmt=png&amp;from=appmsg\"/></section></section><section><section><section><section></section></section></section></section><section><section><section><p><span><br/></span></p></section><section><section><section><section><section><section><p><strong><span>1</span></strong></p></section></section></section></section></section><section><section><p><strong><span>活动时间</span></strong></p></section></section><section><section><section></section></section></section></section><section><section><section><p><span>2025年7月7日至7月8日</span></p></section></section></section><section><p><span><br/></span></p></section><section><section><section><section><section><section><p><strong><span>2</span></strong></p></section></section></section></section></section><section><section><p><strong><span>招收名额</span></strong></p></section></section><section><section><section></section></section></section></section><section><section><section><p><span>约40人（含校内和校外，最终招收名额视报名情况而定）</span></p></section></section></section><section><p><span><br/></span></p></section><section><section><section><section><section><section><p><strong><span>3</span></strong></p></section></section></section></section></section><section><section><p><strong><span>活动形式</span></strong></p></section></section><section><section><section></section></section></section></section><section><section><section><p><span>学术讲座、师生交流等（具体以实际安排为准）</span></p></section></section></section><section><p><span><br/></span></p></section></section></section><section><section><section><section></section></section></section></section><p><span><br/></span></p><p><span><br/></span></p><p><span><br/></span></p><section><section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsFH46Vn0hpeibeDictwwXY8Ju9LI1BOfWPohvGUsS2uxzTWu8V9vk5lmg/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_gif/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsNt2emDyvndjmwLjFZaibmBKPZdfQsBna7geCRHzWktlOo9yvbGjudaw/640?wx_fmt=gif&amp;from=appmsg\"/></section></section><section><section><section><section><p><strong><span>参与报名</span></strong></p></section></section></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_gif/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsAIpRLbk70GPZdnMXFr84F4fF4uta0yrv8e9zAbD7BmbaHdibiarWmGNw/640?wx_fmt=gif&amp;from=appmsg\"/></section></section></section></section></section></section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsDYQh5KWOQrdENDBQg2O33gUiblrkjCwWFgz1VPcOcJYBXGmcn1hNjwQ/640?wx_fmt=png&amp;from=appmsg\"/></section></section><section><section><section><section></section></section></section></section><section><section><section><p><span><br/></span></p></section><section><section><section><section><section><section><p><b><span>1</span></b></p></section></section></section></section></section><section><section><p><b><span>接收报名专业</span></b></p></section></section><section><section><section></section></section></section></section><section><section><section><p><span>1.080100力学（含硕士生、直博生）</span></p><p><span>2.085501机械工程（仅硕士生）</span></p></section></section></section><section><p><span><br/></span></p></section><section><section><section><section><section><section><p><strong><span>2</span></strong></p></section></section></section></section></section><section><section><p><strong><span>申请资格</span></strong></p></section></section><section><section><section></section></section></section></section><section><section><section><p><span>1.拥护中国共产党的领导，遵纪守法，品德良好，学风端正，身心健康；</span></p><p><span>2.全国各高等院校本科三年级在校生（2026年夏季应届毕业生）；</span></p><p><span>3.学习成绩优秀，本科前3年（或前5学期）总评成绩排名原则上在该校同年级本专业前25%之内（在其他方面有突出表现的学生除外）,具有良好的英语表达和应用能力，预计能获得所在高校推荐面试资格；</span></p><p><span>4.对机械工程领域有浓厚兴趣，有较强的创新意识、创新能力和专业能力，有从事学术研究工作的强烈意愿。</span></p></section></section></section><section><p><span><br/></span></p></section><section><section><section><section><section><section><p><strong><span>3</span></strong></p></section></section></section></section></section><section><section><p><strong><span>申请资料</span></strong></p></section></section><section><section><section></section></section></section></section><section><section><section><p><span>1.2025年中山大学先进制造学院优秀大学生夏令营申请表（附件1），须加盖本科院系公章；</span></p><p><span>2.证明学习成绩及排名的成绩单原件或有教务部门盖章的复印件；</span></p><p><span>3.身份证（将正反面复印在一张A4纸上）及学生证（将个人信息页和注册信息页复印在一张A4纸上）复印件；</span></p><p><span>4.全国大学英语四、六级考试成绩单复印件或TOEFL成绩、GRE/GMAT成绩等能够体现自身英语水平的证明材料复印件；</span></p><p><span>5.获奖证书复印件1份（限填5项）；</span></p><p><span>6.体现自身学术水平的代表性学术论文（其中已发表论文提供期刊目录、论文首页，未正式发表论文提供单页摘要）、出版物或原创性工作成果材料的复印件（非必需，自愿提供）；</span></p><p><span>7.具有副高级职称以上的导师推荐信，需导师亲笔签字（非必需，自愿提供）。</span></p><p><span>8.申请直接攻读博士，须提交拟攻读博士学位的科研计划书。</span></p></section><section><p><span><br/></span></p></section></section></section><section><section><section><section><section><section><p><b><span>4</span></b></p></section></section></section></section></section><section><section><p><strong><span>报名流程</span></strong></p></section></section><section><section><section></section></section></section></section><section><section><section><p><strong><span>1.网上报名，提交电子版材料</span></strong></p><p><span>申请夏令营的同学请于</span><span><span>2025年6月22日16:00前</span></span><span>登陆中山大学研究生招生平台进行网上报名并提交电子版材料，注意所填写信息需与电子版申请材料完全一致，报名链接：</span></p><p><span>https://enroll.sysu.edu.cn/yjszs/plugins/zs/zsxsd/entrance#/entrance。</span></p><p><span>请将以下申请材料合成一个PDF文件（文件命名为：姓名-毕业学校-手机号码-夏令营），材料顺序依次是申请表、成绩单、专业排名证明、身份证、学生证、英语水平证明材料、获奖证明、科研成果（如学术论文首页）、推荐信等，请务必确认材料信息无误后再提交。</span></p><p><strong><span>2.提交纸质版材料</span></strong></p><p><span>中山大学先进制造学院2025年全国优秀大学生夏令营采用线下方式进行，请获得入营资格的申请人在入营时将申请表（附件1）的盖章纸质版原件提交给我院核查存档，申请表扫描件应与之后正式报名时递交的纸质材料一致，入营时未提交材料或材料与报名时提交的电子材料不一致的，默认放弃资格。</span></p></section><section><p><span><br/></span></p></section></section></section></section></section><section><section><section><section></section></section></section></section><p><span><br/></span></p><p><span><br/></span></p><p><span><br/></span></p><section><section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsFH46Vn0hpeibeDictwwXY8Ju9LI1BOfWPohvGUsS2uxzTWu8V9vk5lmg/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_gif/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsNt2emDyvndjmwLjFZaibmBKPZdfQsBna7geCRHzWktlOo9yvbGjudaw/640?wx_fmt=gif&amp;from=appmsg\"/></section></section><section><section><section><section><p><b><span>资格审定</span></b></p></section></section></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_gif/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsAIpRLbk70GPZdnMXFr84F4fF4uta0yrv8e9zAbD7BmbaHdibiarWmGNw/640?wx_fmt=gif&amp;from=appmsg\"/></section></section></section></section></section></section><p><span><br/></span></p><section><section><section><section></section></section></section></section><section><section><section><section><p><span>（一）夏令营资格审核与录取由先进制造学院负责，形式审查合格的申请材料，学院将组织专业教师进行综合评议，按一定比例择优确定夏令营入营名单，最终录取名单预计将于6月底在中山大学先进制造学院网站</span></p><p><span>（https://am.sysu.edu.cn/rcpy/yjsjy/index.htm）上公布，未录取者不再另行通知。</span></p><p><span>（二）经审核入选夏令营的同学请按照日程安排的要求，按时参会。如因特殊情况不能参加本次夏令营，请于名单公布后2日内告知我院。</span></p></section></section></section></section><section><section><section><section></section></section></section></section><p><span><br/></span></p><p><span><br/></span></p><p><span><br/></span></p><section><section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsFH46Vn0hpeibeDictwwXY8Ju9LI1BOfWPohvGUsS2uxzTWu8V9vk5lmg/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_gif/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsNt2emDyvndjmwLjFZaibmBKPZdfQsBna7geCRHzWktlOo9yvbGjudaw/640?wx_fmt=gif&amp;from=appmsg\"/></section></section><section><section><section><section><p><strong><span>其他说明</span></strong></p></section></section></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_gif/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsAIpRLbk70GPZdnMXFr84F4fF4uta0yrv8e9zAbD7BmbaHdibiarWmGNw/640?wx_fmt=gif&amp;from=appmsg\"/></section></section></section></section></section></section><p><span><br/></span></p><section><section><section><section></section></section></section></section><section><section><section><section><p><span>（一）本次夏令营活动不收取任何费用，我院将为营员提供夏令营期间的用餐，住宿及往返路费需自理。</span></p><p><span>（二）申请人必须确保提供的信息和材料真实、准确，若发现有弄虚作假行为，一经查实，取消申请资格。</span></p><p><span>（三）营员须全程参加活动，无故缺席将取消营员资格。</span></p></section></section></section></section><section><section><section><section></section></section></section></section><p><span><br/></span></p><p><span><br/></span></p><p><span><br/></span></p><section><section><section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsFH46Vn0hpeibeDictwwXY8Ju9LI1BOfWPohvGUsS2uxzTWu8V9vk5lmg/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_gif/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsNt2emDyvndjmwLjFZaibmBKPZdfQsBna7geCRHzWktlOo9yvbGjudaw/640?wx_fmt=gif&amp;from=appmsg\"/></section></section><section><section><section><section><p><strong><span>咨询方式</span></strong></p></section></section></section></section></section><section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_gif/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsAIpRLbk70GPZdnMXFr84F4fF4uta0yrv8e9zAbD7BmbaHdibiarWmGNw/640?wx_fmt=gif&amp;from=appmsg\"/></section></section></section></section></section></section><p><span><br/></span></p><section><section><section><section></section></section></section></section><section><section><section><section><p><span>联系人：季老师</span></p><p><span>邮   箱：jichy7@mail.sysu.edu.cn</span></p><p><span>邮   编：518107</span></p><p><span>电   话：0755-23262672</span></p><p><span>地   址：广东省深圳市光明区公常路66号中山大学深圳校区理学园东514</span></p><p><span>原  文：https://am.sysu.edu.cn/rcpy/yjsjy/1419203.htm</span></p></section></section></section></section><section><section><section><section></section></section></section></section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_gif/vXae5Sg1WmvNz19I7G4HoCAqJOBjmRMsPBbaWbM5vMOR0gZeYN5CZaBhKzKZsRatnhKvXbqHtWiar0Z1ib8dEuYQ/640?wx_fmt=gif&amp;from=appmsg\"/></section></section><section><p><span><span>——  中山大学先进制造学院  ——</span></span></p><p><span><span>排版：陈昕乐</span></span></p><p><span><span>初审：李宁</span><span><br/></span></span></p><p><span><span>审核：陈方</span></span></p><p><span><span>审核发布：戴怡平</span></span></p></section></section><p></p></div>","textSha256":"6e3ca530bc2f06c873b8fa1d7dc5a2155f58a60533b4b37a7491ef9bbd3495e0","textLength":2056,"sourceSha256":"ce160d0c4b68e5183f4f5080dc9c4d92d1e749adce9bd5f6b99acd48