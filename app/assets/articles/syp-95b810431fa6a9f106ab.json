n></span></span></span></td><td><span><span><span><span><span><span>105111</span></span></span></span></span></span></td><td><span><span><span><span><span><span><span><span><span><span><span><span>外科学</span></span></span></span></span></span></span></span></span></span></span></span></td><td><span><span><span><span><span><span>69</span></span></span></span></span></span></td><td><span><span><span><span><span><span><span><span><span><span><span><span>不分方向</span></span></span></span></span></span></span></span></span></span></span></span></td></tr><tr><td><span><span><span><span><span><span><span><span><span><span><span><span>专硕</span></span></span></span></span></span></span></span></span></span></span></span></td><td><span><span><span><span><span><span>105109</span></span></span></span></span></span></td><td><span><span><span><span><span><span><span><span><span><span><span><span>全科医学</span></span></span></span></span></span></span></span></span></span></span></span></td><td><span><span><span><span><span><span>69</span></span></span></span></span></span></td><td><span><span><span><span><span><span><span><span><span><span><span><span>不分方向</span></span></span></span></span></span></span></span></span></span></span></span></td></tr><tr><td><span><span><span><span><span><span><span><span><span><span><span><span>专硕</span></span></span></span></span></span></span></span></span></span></span></span></td><td><span><span><span><span><span><span>105500</span></span></span></span></span></span></td><td><span><span><span><span><span><span><span><span><span><span><span><span>药学</span></span></span></span></span></span></span></span></span></span></span></span></td><td><span><span><span><span><span><span>69</span></span></span></span></span></span></td><td><span><span><span><span><span><span><span><span><span><span><span><span>不分方向</span></span></span></span></span></span></span></span></span></span></span></span></td><td> </td></tr><tr><td><span><span><span><span><span><span><span><span><span><span><span><span>专硕</span></span></span></span></span></span></span></span></span></span></span></span></td><td><span><span><span><span><span><span>105800</span></span></span></span></span></span></td><td><span><span><span><span><span><span><span><span><span><span><span><span>医学技术</span></span></span></span></span></span></span></span></span></span></span></span></td><td><span><span><span><span><span><span>81</span></span></span></span></span></span></td><td><span><span><span><span><span><span><span><span><span><span><span><span>医学影像技术</span></span></span></span></span></span></span></span></span></span></span></span></td><td> </td></tr></tbody></table><p><span><span><font>我院拟接收推荐免试研究生学科专业方向</font></span></span><span><span><font>可同步</font></span></span><span><span><font>见推免生预报名系统</font><font>https://enroll.sysu.edu.cn/</font><font>。</font></span></span></p><p><span><span><font>说明：实际招生专业以学校最终公布的</font>202</span></span><span><span><font>7</font></span></span><span><span><font>年研究生招生专业目录为准。</font></span></span><span><span><font>各专业实际接收推免生人数将根据招生计划、生源情况等进行调整，以实际录取为准。</font></span></span></p><p><b><span><span><font>三、报名</font></span></span></b><b><span><span><font>申请</font></span></span><br/><span><font>    （一）申请材料</font></span></b><br/><span><p></p></span></p><p><span><font>申请者请最晚于</font><font>9</font><font>月</font></span><span><font>20</font></span><span><font>日</font><font>24:00</font><font>前将以下材料整合为</font><font>1</font><font>个</font><font>PDF</font><font>文件作为附件发送至邮箱</font><font>zsqyyjsk@mail.sysu.edu.cn</font><font>，邮件名称与申请材料文件均命名为“姓名</font><font>+</font><font>本科就读高校</font><font>+</font><font>申请专业</font><font>+2027</font><font>年推免生报名材料”。</font></span><span><p></p></span></p><p><span><font>1</font></span><span><font>.</font></span><span><font>个人简历（限</font><font>2</font><font>页以内</font></span><span><font>，扫描</font><font>PDF</font><font>版</font></span><span><font>）；</font></span><span><p></p></span></p><p><span><font>2</font></span><span><font>.</font></span><span><font>身份证扫描件（正反面复印在一页</font><font>A4</font><font>纸上）；</font></span><span><p></p></span></p><p><span><font>3</font></span><span><font>.</font></span><span><font>加盖有效注册印章的在校学生证扫描件；</font></span><span><p></p></span></p><p><span><font>4</font></span><span><font>.</font></span><span><font>加盖教务部门公章的本科阶段成绩单及成绩总评证明扫描件；</font></span><span><p></p></span></p><p><span><font>5</font></span><span><font>.</font></span><span><font>英语水平证明材料（英语四</font><font>/</font><font>六级或 </font><font>TOEFL</font><font>、</font><font>IELTS</font><font>、</font><font>GRE</font><font>、</font><font>GMAT</font><font>等体现自身英语水平的考试成绩单扫描件）；</font></span><span><p></p></span></p><p><span><font>6</font></span><span><font>.</font></span><span><font>公开发表的文章扫描件（需标注出个人姓名）；</font></span><span><p></p></span></p><p><span><font>7</font></span><span><font>.</font></span><span><font>负责或参与的科研项目扫描件（含项目书盖章页、参与人信息页）；</font></span><span><p></p></span></p><p><span><font>8</font></span><span><font>.</font></span><span><font>各类获奖证书扫描件；</font></span><span><p></p></span></p><p><span><font>9</font></span><span><font>.</font></span><span><font>中山大学研究生招生考生诚信复试承诺书（附件</font><font>1</font><font>）</font></span><span><font>；</font></span><span><p></p></span></p><p><span><font>10</font></span><span><font>.</font></span><span><font>其他辅助材料等。</font></span><span><p></p></span></p><p><span><font>申请</font></span><span><font>者</font></span><span><font>须承诺所提供信息、材料及申请身份的真实性。一经查证为不属实或不符合我校招生要求的，我校将取消其申请资格、录取资格、入学资格，已入学的取消学籍。</font></span><span><p></p></span></p><p><span><font>申请</font></span><span><font>者</font></span><span><font>若存在有违学术道德、专业伦理、诚实守信等方面的不当行为，一经查实，立即取消其申请资格、录取资格、入学资格，已入学的取消学籍。</font></span><span><p></p></span></p><p><b><span><font>（</font></span></b><b><span><font>二</font></span></b><b><span><font>）</font></span></b><b><span><font>申请流程</font></span></b><b><span><p></p></span></b></p><p><span><font>推免生的预报名及考核录取均通过中山大学推荐免试攻读研究生预报名系统（以下简称</font><font>“预推免系统”，网址</font><font>: https://enroll.sysu.edu.cn/</font><font>）进行。</font></span><span><p></p></span></p><p><span><font>1.</font><font>申请者须即日起在“预推免系统”完成网上报名。截止报名时间：</font><font>2026</font><font>年</font><font>9</font><font>月</font></span><span><font>2</font></span><span><font>0</font></span><span><font>日</font><font>24:00</font><font>。</font></span><span><p></p></span></p><p><span><font>2.</font><font>请申请者密切关注我院在“预推免系统”及医院官网：</font><font>https://www.sysush.com/education</font><font>公布的相关信息。</font></span><span><p></p></span></p><p><b><span><font>四</font></span></b><b><span><font>、</font></span></b><b><span><font>初审与复试</font></span></b><b><span><p></p></span></b></p><p><b><span><font>（</font></span></b><b><span><font>一</font></span></b><b><span><font>）</font></span></b><b><span><font>初审</font></span></b><b><span><p></p></span></b></p><p><span><font>我院组织</font></span><span><font>对申请材料初审后，通知</font></span><span><font>审核</font></span><span><font>通过的申请人参加复试。申请人须按学校及我院报考要求做好复试准备工作，按时参加复试。</font></span><span><p></p></span></p><p><b><span><font>（</font></span></b><b><span><font>二</font></span></b><b><span><font>）</font></span></b><b><span><font>复试</font></span></b><b><span><p></p></span></b></p><p><span><font>1.</font><font>复试形式：现场</font></span><span><font>复试。</font></span><span><p></p></span></p><p><span><font>2</font></span><span>.</span><span><font>复试总分：</font></span><span>100<font>分</font></span><span><font>，其中</font><font>30%</font><font>为英语考核，</font><font>70%</font><font>为业务能力及综合素质考核。</font></span><span><p></p></span></p><p><span><font>3.</font><font>考核时间：硕士推免生的面试总时间不少于</font><font>20</font><font>分钟。</font></span><span><p></p></span></p><p><span><font>4</font></span><span>.</span><span><font>考核方式：复试小组对参加复试的考生进行逐个考核，考生当场回答问题或操作，必要时，复试小组成员会就相关问题进一步提问。</font></span><span><p></p></span></p><p><span><font>5.</font></span><span><font>复试内容</font></span><span><font>：</font></span><span><font>重点考察外语应用能力、专业素质及能力、实践（实验）能力、思想政治素质和品德、心理健康状况等。</font></span><span><p></p></span></p><p><span><font>6.</font><font>考核评分：每位考生复试结束后，由复试小组成员现场独立为考生评分。复试小组成员考核总分的算术平均值为该考生的最终复试成绩。成绩按四舍五入原则，保留小数点后两位。复试成绩不及格（低于</font><font>60</font><font>分）者，不予录取。</font></span><span><p></p></span></p><p><span><font>复试实行差额复试，根据复试成绩择优录取，未按规定参加复试或复试不及格者不予录取。复试过程全程录音录像。</font></span><span><p></p></span></p><p><span><font>对于报考人数充足的招生学科、专业，按照复试成绩由高到低的顺序确定各专业拟录取推免生名单。对于报考人数不足的招生学科、专业，可向其他生源充足的相近专业进行调剂复试录取，但须符合报名条件。院内跨学科</font><font>/</font><font>专业调剂须重新复试，二级学科内调剂可免复试。调剂复试和拟录取推免生的名单均严格按照复试成绩由高到低的顺序确定。</font></span><span><p></p></span></p><p><span><font>不参加复试或复试不合格者不予录取。</font></span><span><p></p></span></p><p><span><font>申请者在参加复试时，须提供本人有效第二代居民身份证、学生证、加盖有推荐学校教务处公章的本科阶段学习成绩单，以备查验。</font></span><span><font>上述证件的复印件及本科阶段学习成绩单原件须交我院存档。</font></span><span><p></p></span></p><p><b><span><font>五</font></span></b><b><span><font>、</font></span></b><b><span><font>考核通过名单</font></span></b><b><span><font>公</font></span></b><b><span><font>布</font></span></b><b><span><p></p></span></b></p><p><span><font>我院将</font></span><span><font>根据复试情况，择优确定</font></span><span><font>考核通过</font></span><span><font>名单</font></span><span><font>并于我院</font><font>官网公布。</font></span><span><p></p></span></p><p><span><font>后续将</font></span><span><font>通过教育部</font><font>“推免服务系统”向拟接收的申请人发送待录取通知，收到待录取通知的申请者，须在规定时间内在“推免服务系统”上完成待录取确认，逾期未完成确认者视为放弃待录取资格。在“推免服务系统”上完成待录取确认的推免生不得变更录取志愿，不得撤销待录取。</font></span><span><p></p></span></p><p><b><span><font>六</font></span></b><b><span><font>、</font></span></b><b><span><font>其他</font></span></b><b><span><font>事项</font></span></b><b><span><p></p></span></b></p><p><span><font>1.</font><font>说明</font></span><span><p></p></span></p><p><span><font>此通知为报名通知，具体要求以教育部及中山大学</font>202</span><span><font>7</font></span><span><font>年推荐免试研究生</font></span><span><font>接收办法</font></span><span><font>及相关工作</font></span><span><font>通知为准。</font></span><span><p></p></span></p><p><span><font>推免生的报名及录取均通过教育部</font><font>“全国推荐免试攻读研究生（免初试、转段）信息公开管理服务系统”（以下简称“推免服务系统”，网址</font></span><span>: https://yz.chsi.com.cn/tm/<font>）进行</font></span><span><font>。</font></span><span><p></p></span></p><p><span><font>推免复审及体检要求请留意学校及院系后续发布的推免接收办法及相关通知。</font></span><span><p></p></span></p><p><span><font>2</font></span><span><font>.</font><font>联系方式</font></span><span><p></p></span></p><p><span><font>联系人：</font></span><span><font>刘</font></span><span><font>老师、</font></span><span><font>龙</font></span><span><font>老师</font></span><span><p></p></span></p><p><span><font>联系电话：</font><font>0755-81207020</font><font>、</font><font>0755-23242106</font></span><span><p></p></span></p><p><span><font>邮箱：</font><font>zsqyyjsk@mail.sysu.edu.cn</font></span><span><p></p></span></p><p><span><font>邮政地址</font><font>:  </font><font>广东省深圳市光明区圳园路 </font><font>628 </font><font>号（中山大学附属第七医院行政楼 </font><font>511 </font><font>室）</font></span><span><p></p></span></p><p><span><p> </p></span></p><p><span><font>中山大学附属第七医院</font></span><span><p></p></span></p><p><span><font>2026</font><font>年</font></span><span><font>9</font></span><span><font>月</font></span><span><font>17</font></span><span><font>日</font></span><span><p></p></span></p><p><span><p> </p></span></p><p><a href=\"https://www.sysush.com/sites/sysush1.live.sysucloud1.sysu.edu.cn/files/2025-12/2027%E5%B9%B4%E6%8E%A8%E5%85%8D/%E9%99%84%E4%BB%B61%EF%BC%9A%E4%B8%AD%E5%B1%B1%E5%A4%A7%E5%AD%A6%E7%A0%94%E7%A9%B6%E7%94%9F%E6%8B%9B%E7%94%9F%E8%AF%9A%E4%BF%A1%E5%A4%8D%E8%AF%95%E6%89%BF%E8%AF%BA%E4%B9%A6.docx\" rel=\"noopener noreferrer\" target=\"_blank\"><span><font>附件：</font></span><span><p></p></span><span><font>1.</font><font>中山大学研究生招生诚信复试承诺书</font></span></a><span><p></p></span></p><p><span><p> </p></span></p><p><span><p></p></span></p></div></div>","textSha256":"5ca219aa8895606073a7ceb17d3505bf545c5ad88b523e97027047aa5d350619","textLength":2864,"sourceSha256":"7825d99902738e324ca651907cfd7c32a01db351e75261ec122715a1f72ddb9e","selector":".article-content","attachments":[],"pdfs":[],"unavailableMedia":[],"id":"syp-95b810431fa6a9f106ab","title":"2026年中山大学附属第七医院2027年接收优秀应届本科毕业生推荐免试攻读研究生报名通知","capturedAt":"2026-11-15T16:52:37.263548+00:00"}
