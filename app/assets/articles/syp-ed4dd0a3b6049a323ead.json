"https://mmbiz.qpic.cn/sz_mmbiz_jpg/lyPYjbCQW8ekb8lvIHiciaGABxMlhOj2dEzOmEG6fqFzYILRc5UQicianfaUmQ9GDUjhR0DsliaFHpkAEtZia2m3Uiaxg/640?wx_fmt=jpeg\"/></section></section></section></section><p><span><br/></span></p><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_gif/lyPYjbCQW8crX3SCScSjicCpRnJgPBkiahYAf56Ke2jPyJeVLicpUU7ztNR3fQV2MNRzIMpwaxWS7kwC83OCrqM9w/640?wx_fmt=gif\"/></section></section></section><p></p></div>","textSha256":"533c6504f0dd631f9c115866e36f97b0ebc0d986f6bd6db8aa28452220e2bfbc","textLength":1940,"sourceSha256":"ae9b8ea6c7d696a9c622ea0756f8a6fb1dfc76a6e9709d89c05fb6ccf9108aa0","selector":"#js_content","attachments":[],"pdfs":[],"unavailableMedia":[],"id":"syp-ed4dd0a3b6049a323ead","title":"2025年浙江大学爱丁堡大学联合学院第七届优秀大学生暑期夏令营","capturedAt":"2026-11-15T16:56:53.805058+00:00"}
