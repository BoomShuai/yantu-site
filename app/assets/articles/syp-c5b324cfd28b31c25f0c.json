=1&amp;tp=wxpic#imgIndex=7\"/></span></a></section></section><section><section><a href=\"https://mp.weixin.qq.com/mp/appmsgalbum?__biz=Mzg4NjgwMDM2MA==&amp;action=getalbum&amp;album_id=4210131145561882635#wechat_redirect\" rel=\"noopener noreferrer\" target=\"_blank\"><span><img alt=\"图片\" loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/VINpFibJevLSGpMEVnYdA69COU0ticicnnbh3ykVWiaQHJI5UZvoBolsG3EWOWhDu4kvMouEqVGBW46sh5TXfQk733L7UUnq7NzFmHLJuxDxSZQ/640?wx_fmt=png&amp;from=appmsg&amp;wxfrom=5&amp;wx_lazy=1&amp;tp=wxpic#imgIndex=8\"/></span></a></section></section></section></section></section></section></section></section></section></section></section><p><span><br/></span></p></section><p></p></div>","textSha256":"a0d82edd96a0bd157837c4a367733db2ae9f5921c48d616543d94e33f5c1e753","textLength":1314,"sourceSha256":"b69f95ce2383da19020186d6d8925bb97eaef01461f32c16aafdf4fda5d318c6","selector":"#js_content","attachments":[],"pdfs":[],"unavailableMedia":[],"id":"syp-c5b324cfd28b31c25f0c","title":"2026年暨南大学产业经济研究院2027年接收全国高校优秀应届本科推免生报名公告","capturedAt":"2026-11-15T16:54:07.685583+00:00"}
