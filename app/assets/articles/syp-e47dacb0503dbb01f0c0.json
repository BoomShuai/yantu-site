ading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/mmbiz_png/CiblDpJMP7PIwiaWMt4Iib7ibJmmpYbjoTHKfpZwljsOQm5N05QpFgv7XHHzfLN3grIc7IjjtEIGrpPLZibkI4LBZ03g1m6lls2ZKJ2cq9UuL8x8/640?wx_fmt=png\"/></section></section></a><a href=\"https://mp.weixin.qq.com/s?__biz=MzIyOTU3MjU4OA==&amp;mid=2247525754&amp;idx=1&amp;sn=e45b919d95924c2492bee102c297ff89&amp;scene=21#wechat_redirect\" rel=\"noopener noreferrer\" target=\"_blank\" title=\"https://mp.weixin.qq.com/s?__biz=MzIyOTU3MjU4OA==&amp;mid=2247525754&amp;idx=1&amp;sn=e45b919d95924c2492bee102c297ff89&amp;scene=21#wechat_redirect\"><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/CiblDpJMP7PIJFxNaU6hY2RKgmDrlHJ07icJLtBC0mSHeLHElaQQQ7axyITUyruWx8kXmOLibyG61l7K2If8oiccUeqX6XCOT4UFiarMab1HRVFM/640?wx_fmt=png\"/></section></section></a></section><p></p></div>","textSha256":"e4278c1abcc669bca560b2bcc3ea1178a935f39f9689eeba1caf215c24e4204e","textLength":1756,"sourceSha256":"2fa1f5f77a89ff211c85fd80a7dbd17d69199d8c331a58376741f1994abe08cf","selector":"#js_content","attachments":[],"pdfs":[],"unavailableMedia":[],"id":"syp-e47dacb0503dbb01f0c0","title":"2026年南方科技大学海洋科学与工程系2027级推荐免试研究生（含直博生）预报名通知","capturedAt":"2026-11-15T16:53:27.336385+00:00"}
