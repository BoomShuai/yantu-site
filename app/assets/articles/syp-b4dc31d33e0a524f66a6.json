3dc9c072a3d11a7a0ea960ee88bf426e0bb62ecd1ffbeda5594f9","textLength":2693,"sourceSha256":"e234a9bcf24fa92568c87c4b3bf45c8b0b4c8707c7a8034a70b84b23b6ade486","selector":"#js_content","attachments":[],"pdfs":[],"unavailableMedia":[],"id":"syp-b4dc31d33e0a524f66a6","title":"2025年中国科学院青岛生物能源与过程研究所“清源聚能”大学生夏令营活动通知","capturedAt":"2026-11-15T16:59:09.704042+00:00"}
