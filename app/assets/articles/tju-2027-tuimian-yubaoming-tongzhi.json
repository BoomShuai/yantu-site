</td>\n<td><font>022-27402304；</font><a href=\"http://ji_henley@tju.edu.cn\" rel=\"noopener noreferrer\" target=\"_blank\" title=\"\"><font>ji_henley@tju.edu.cn</font></a></td>\n</tr>\n<tr>\n<td>308</td>\n<td>国际教育学院</td>\n<td><font>8月15</font><font>日；</font><font>9月15日</font></td>\n<td>刘老师</td>\n<td>022-27400919</td>\n</tr>\n<tr>\n<td>401</td>\n<td>体育部</td>\n<td>9月11日</td>\n<td>王老师，兰老师</td>\n<td><font>022-27403611;</font><a href=\"http://tyb@tju.edu.cn\" rel=\"noopener noreferrer\" target=\"_blank\" title=\"\"><font>tyb@tju.edu.cn</font></a></td>\n</tr>\n<tr>\n<td>429</td>\n<td>纳电子科学与芯片工程学院（纳米中心）</td>\n<td>8月1日，9月1日，9月15日</td>\n<td>朱老师，李老师</td>\n<td>13072095828</td>\n</tr>\n<tr>\n<td>439</td>\n<td>天津大学福州国际联合学院</td>\n<td>9月12日 </td>\n<td><span>李老师，</span>彭老师 </td>\n<td>0591-62602686</td>\n</tr>\n<tr>\n<td>待定</td>\n<td>天津大学香港理工大学深圳未来技术学院</td>\n<td>8月15日，9月15日</td>\n<td>丁老师</td>\n<td><font>0755-36881006转349；</font><a href=\"http://sz.grad@tju.edu.cn\" rel=\"noopener noreferrer\" target=\"_blank\" title=\"\"><font>sz.grad@tju.edu.cn</font></a></td>\n</tr>\n</tbody>\n</table>\n<p>\n\n</p>\n<p><span><br/>\n</span></p>\n<p><b><span>四</span><span>、其他说明</span></b><span></span></p>\n<p><span>1. </span><span>申请人必须保证提交的申请信息及全部申请材料的真实性和准确性。对在推免过程中存在弄虚作假、有违学术道德和专业伦理等不当行为的，或存在其他严重影响推免过程和结果公平公正行为的，一经查实，</span><span>取消我校</span><span>免试读研资格。</span><span></span></p>\n<p><span>2.</span><span> </span><span>我校将在录取当年</span><span>5</span><span>-</span><span>6</span><span>月对所有拟录取的推免生进行资格复审。通过资格复审后，方可被正式录取，我校予以发放录取通知书。未通过资格复审者，取消其研究生录取资格。</span><span></span></p>\n<p><span>3.</span><span>本通知内容与教育主管部门下达文件不符的，以教育主管部门下达的文件为准。</span><span></span></p>\n<p><span>4.</span><span>咨询方式</span><span></span></p>\n<p><span>各院系咨询电话或邮箱见</span><span>上表或</span><span>招生专业目录。</span><span></span></p>\n<p><span>天津大学</span><span>研究生</span><span>招生</span><span>网址：</span><a href=\"http://yzb.tju.edu.cn/\" rel=\"noopener noreferrer\" target=\"_blank\"><u><span>http://yzb.tju.edu.cn/</span></u></a><span>，</span><span><font>或微信公众号关注</font><font>“天津大学研究生招生”。</font></span><span></span></p>\n<p><span>天津大学研究生招生</span><span>办公室</span><span>联系邮箱</span><span>和</span><span>电话</span><span>：</span><span> </span><span>yzb@tju.edu.cn</span><span>，</span><span>02</span><span>2</span><span>-27</span><span>40</span><span>64</span><span>05</span><span></span></p>\n<p><span>天津大学研究生招生办公室</span><span></span></p>\n<p><span>202</span><span>6</span><span>年</span><span>7</span><span>月</span><span></span></p></div>",
