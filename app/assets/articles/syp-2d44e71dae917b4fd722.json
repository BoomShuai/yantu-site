ection></section></section><section><p><span><br/></span></p></section></section></section><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/ufkmz2ibR8w5MSVIs34C2euF03FB9lZO88ecDEfHEuzEy7jTXYPpyJ9Sa6TIAj2Z04bG8N8K6C4XpvvnxzVjplQ/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section></section></section></section><p><span><br/></span></p><p><span><br/></span></p><p><span><br/></span></p><section><section><section><section><p><strong><span>END</span></strong></p></section></section></section></section><p><span><br/></span></p><p><span><br/></span></p><section><section><section><p><span>本文来自中国科学院古脊椎动物与古人类研究所，</span></p><p><span>未经授权不得转载</span></p><p><span>如有需要请联系kxcb@ivpp.ac.cn</span></p></section></section></section><p><span><br/></span></p><section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/ufkmz2ibR8w5MSVIs34C2euF03FB9lZO8qeOQCU9jXFMXutyD9dK7Tfs7CeEGgQPDerrpQgiapk5VMVNwwsfCrwA/640?wx_fmt=png&amp;from=appmsg\"/></section></section></section><section><img loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"assets/articles/media/f7ca634f2ce53e30f02c.gif\"/></section><p></p></div>","textSha256":"7bb45178bc5985852f0eaeb58478742998d24603a1502d2588f0fbf8c8f1466b","textLength":1818,"sourceSha256":"0215848e6c1a7020fbbb0c19070c034df61861aa1c3b2a50978b96052119ccdb","selector":"#js_content","attachments":[],"pdfs":[],"unavailableMedia":[],"id":"syp-2d44e71dae917b4fd722","title":"2025年中国科学院古脊椎动物与古人类研究所第十三届大学生夏令营通知（第二轮）","capturedAt":"2026-11-15T16:58:58.586631+00:00","mirroredImages":[{"sourceUrl":"http://mmbiz.qpic.cn/mmbiz_gif/ufkmz2ibR8w5OHiaKXaxh8XxsLgOXoj0bxEfV0SyiaOIWn60Yf0PPvibib5MdbNIBpqXYWkibJQ32ZzPVb8cDUTibaLNQ/640?wx_fmt=gif","file":"assets/articles/media/f7ca634f2ce53e30f02c.gif"}]}
